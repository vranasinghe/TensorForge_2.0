[Unit]
Description=TensorForge RideEat classification API
After=network.target

[Service]
Type=simple
User=tensorforge
Group=tensorforge
WorkingDirectory=/opt/tensorforge
EnvironmentFile=/etc/tensorforge/api.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=JOB_DB=/var/lib/tensorforge/jobs.sqlite3
ExecStart=/opt/tensorforge/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
StateDirectory=tensorforge
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tensorforge
MemoryMax=3G
CPUQuota=200%
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
